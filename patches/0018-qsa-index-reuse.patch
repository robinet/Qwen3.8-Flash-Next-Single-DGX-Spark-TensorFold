+def _qsa_row(scratch: AttnScratch, row: int):
+    """A one-row view of the row's scratch slices for the reuse ring's explicit-position launches."""
+
+    return SimpleNamespace(ratio=scratch.ratio, budget=scratch.budget, nb=scratch.nb, idw=scratch.idw,
+                           scores=scratch.scores[row:row + 1], ids=scratch.ids[row:row + 1],
+                           nk=scratch.nk[row:row + 1], sparse=scratch.sparse[row:row + 1])
+
