 SELECT_REGS = 32768  # _select holds a row's block scores in registers up to this many; past it they spill
 
 
+class _QSAReuse:
+    """One stream/layer/cache-domain's selected block ring, keyed by its pooled cache object."""
+
+    __slots__ = ("t", "ids", "end", "complete", "sparse")
+
+    def __init__(self, pooled: torch.Tensor, top: int) -> None:
+        self.t = weakref.ref(pooled)
+        self.ids = torch.empty((top,), dtype=torch.int32, device=pooled.device)
+        self.end = -1
+        self.complete = 0
+        self.sparse = False
+
+
+_QSA_REUSE: dict[int, _QSAReuse] = {}
+
+
+def _reuse_ring(pooled: torch.Tensor, top: int) -> _QSAReuse:
+    """One ring per pooled cache object; a replaced or freed cache yields a fresh ring."""
+
+    key = id(pooled)
+    ring = _QSA_REUSE.get(key)
+    if ring is None or ring.t() is not pooled or ring.ids.numel() != top:
+        ring = _QSAReuse(pooled, top)
+        _QSA_REUSE[key] = ring
+    return ring
+
+
+def _forget_reuse(pooled: torch.Tensor) -> None:
+    ring = _QSA_REUSE.get(id(pooled))
+    if ring is not None and ring.t() is pooled:
+        _QSA_REUSE.pop(id(pooled), None)
+
