+def _qsa_reuse_rows(iq: torch.Tensor, pooled: torch.Tensor, pos0: torch.Tensor, scratch: AttnScratch, rows: int,
+                    context: int) -> None:
+    """Reuse one cache's prior selected blocks for later rows of the same decode: a row with no new
+    blocks copies the ring, a row that completed new blocks rescores only the inherited TOP plus them.
+    The ring survives MTP step boundaries (the row's end only moves forward while a request decodes);
+    a backwards or equal end (rejection, resize) or a dense ring falls back to a full score+select."""
+
+    di = pooled.shape[1]
+    ratio, top, bb = scratch.ratio, scratch.budget // scratch.ratio, 64
+    blocks = min(scratch.nb, max(1, triton.cdiv(context, ratio)))
+    base = context - rows
+    ring = None
+    for r in range(rows):
+        end = base + r + 1
+        complete = end // ratio
+        row = _qsa_row(scratch, r)
+        if complete <= top:
+            _forget_reuse(pooled)
+            ring = None
+            _scores[(1, triton.cdiv(blocks, bb))](iq[r:r + 1], pooled, pos0, row.scores, scratch.nb,
+                                                 HI=iq.shape[1], DI=di, RATIO=ratio, TOP=top, BB=bb,
+                                                 BASE=end - 1, num_warps=4)
+            _launch_select(row, pos0, 1, blocks, base=end - 1)
+            continue
+        if ring is None:
+            ring = _reuse_ring(pooled, top)
+        if not (ring.sparse and ring.end < end and ring.complete <= complete):
+            _scores[(1, triton.cdiv(blocks, bb))](iq[r:r + 1], pooled, pos0, row.scores, scratch.nb,
+                                                 HI=iq.shape[1], DI=di, RATIO=ratio, TOP=top, BB=bb,
+                                                 BASE=end - 1, num_warps=4)
+            _launch_select(row, pos0, 1, blocks, base=end - 1)
