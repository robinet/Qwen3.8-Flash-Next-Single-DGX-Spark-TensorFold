+
+
+@triton.jit
+def _scores_tc(IQ, POOLED, POS0, SC, NB, ROWS,
+               HI: tl.constexpr, DI: tl.constexpr, RATIO: tl.constexpr, TOP: tl.constexpr,
+               BR: tl.constexpr, BB: tl.constexpr):
+    """Same scores as ``_scores``, several rows sharing one key tile through ``tl.dot``."""
+
+    r0 = tl.program_id(0) * BR
+    b0 = tl.program_id(1) * BB
+    r = r0 + tl.arange(0, BR)
+    b = b0 + tl.arange(0, BB)
+    d = tl.arange(0, DI)
+    p0 = tl.load(POS0)
+    complete = (p0 + r + 1) // RATIO
+    acc = tl.zeros((BR, BB), tl.float32)
+    for h in tl.static_range(HI):
+        q = tl.load(IQ + (r[:, None] * HI + h) * DI + d[None, :], mask=r[:, None] < ROWS, other=0.0).to(tl.float32)
+        k = tl.load(POOLED + b[None, :].to(tl.int64) * DI + d[:, None], mask=b[None, :] < NB, other=0.0).to(tl.float32)
+        acc += tl.maximum(tl.dot(q, k), 0.0)
+    live = (r[:, None] < ROWS) & (b[None, :] < complete[:, None]) & (complete[:, None] > TOP) & (b[None, :] < NB)
+    tl.store(SC + r[:, None].to(tl.int64) * NB + b[None, :], acc * (1.0 / tl.sqrt(DI * 1.0)), mask=live)
 
 
