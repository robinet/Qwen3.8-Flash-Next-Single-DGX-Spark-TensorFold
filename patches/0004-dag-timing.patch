+++ tensorfold/families/qwen4_exp/cuda/zdiag.py
@@ -0,0 +1,50 @@
+"""Per-block GPU timing for the Flash Next forward, off unless TF_DIAG_TIMING is set.
+
+Values: 1 or all -> flush and print on every pass and round; prefill -> prefill and mixed
+passes only (decode rounds clear their events without printing, so decode stays pristine).
+"""
+import json
+import os
+
+MODE = (os.environ.get("TENSORFOLD_DIAG_TIMING") or os.environ.get("TF_DIAG_TIMING") or "").strip().lower()
+ON = MODE in ("1", "all", "prefill")
+TEVS = []
+TACC = {}
+
+
+def t0(tag):
+    if not ON:
+        return None
+    import torch
+
+    e0 = torch.cuda.Event(enable_timing=True)
+    e0.record()
+    return (tag, e0)
+
+
+def t1(t):
+    if not ON or t is None:
+        return
+    import torch
+
+    e1 = torch.cuda.Event(enable_timing=True)
+    e1.record()
+    TEVS.append((t[0], t[1], e1))
+
+
+def flush(label):
+    if not ON:
+        return
+    if label.startswith("decode") and MODE == "prefill":
+        TEVS.clear()
+        return
+    if not TEVS:
+        return
+    import torch
+
+    torch.cuda.synchronize()
+    for tg, e0, e1 in TEVS:
+        TACC[tg] = TACC.get(tg, 0.0) + e0.elapsed_time(e1)
+    TEVS.clear()
+    print(f"[timing] {label}", json.dumps({k: round(v, 1) for k, v in TACC.items()}, sort_keys=True), flush=True)
+    TACC.clear()
