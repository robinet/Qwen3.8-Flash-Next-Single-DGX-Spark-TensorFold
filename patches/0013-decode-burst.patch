+    def _decode_burst(self) -> list:
+        """Decode-only rounds while a prompt is still filling.
+
+        One ``round`` beside a fill is one decode window plus one prompt pass, so a
+        decoding stream sits at ~2 tok/s next to a 512k prefill. Shrinking the pass
+        (``--decode-share``) re-reads expert weights and does not add rounds.
+        Parking the fill list makes ``round`` decode-only; ``TENSORFOLD_DECODE_BURST``
+        is how many of those to run per pass (0, the default: stock cadence).
+        """
+
+        import os
+
+        raw = os.environ.get("TENSORFOLD_DECODE_BURST", "").strip()
+        n = int(raw) if raw.isdecimal() else 0
+        dec = self.decoder
+        if n <= 0 or not getattr(dec, "filling", None) or not dec.live():
+            return []
+        saved = dec.filling
+        dec.filling = []
+        ended: list = []
+        try:
+            for _ in range(n):
+                if not dec.live():
+                    break
+                ended += dec.round()
+        finally:
+            dec.filling = saved
+        return ended
+
     def _loop(self) -> None:
         while True:
             self._yield()
