# Local settings for scripts/config.sh (read by start.sh, stop.sh and scripts/*.sh).
# A variable already set in the environment (e.g. `PORT=9000 ./start.sh`) wins over this file.
# Unset lines below; a variable set in the environment still wins over a line in this file.

# --- model and image (defaults shown) ------------------------------------------
# MODEL_ID=Vontra/Qwen3.8-Flash-Next-MLX-4bit-MTP
# Patches only work with this TensorFold release; after changing any of the three, run `scripts/prepare.sh --rebuild`.
# TF_VERSION=v0.6.1
TF_VERSION=v0.6.2
# TF_REPO=https://github.com/ashhart/TensorFold.git
# BASE_IMAGE=nvcr.io/nvidia/pytorch:26.07-py3
# IMAGE=tensorfold-qwen38:${TF_VERSION}${DRAFT_LANGUAGE:+-languages}   # local image name prepare.sh builds or pulls
# CONTAINER_NAME=qwen38-flash-next-tf          # the server's container
# GHCR_IMAGE=ghcr.io/miaai-lab/qwen3.8-flash-next-single-dgx-spark-tensorfold
# DRAFT_LANGUAGE=   # zh or ja for mostly Chinese/Japanese replies (zh measured +48% decode); de, fr, pt, ru also accepted but not measured; several: "zh,ja"; leave unset otherwise

# --- serving ---------------------------------------------------------------------
SERVED_NAME=qwen3.8-flash-next                # the model id clients see in /v1/models (pinned: the recipe default is Qwen3.8-Flash-Next)
HOST=0.0.0.0                                  # 0.0.0.0: reachable on the LAN
PORT=8000                                     # pinned: the recipe default is 8888
PARALLEL=2                                    # CUDA Flash Next refuses --vision with one stream; 2 x 524,288 int8 is ~104 GiB, fits the ~116 GiB budget
CONTEXT=524288                                # prompt + reply window per stream (beyond the model's native 262,144 via NATIVE_CONTEXT)
NATIVE_CONTEXT=524288                         # rewrites the cached config.json's max_position_embeddings (plain RoPE extrapolation beyond the trained range)
KV_DTYPE=int8                                 # bf16 | int8 | int4 (int4 tested at 512k: prefill identical, so the floor is not KV traffic)
# DECODE_SHARE=0.5    # while a sibling prefills: the share of each prompt pass's time a decoding stream keeps (0/empty: it starves)
TENSORFOLD_DECODE_BURST=512       # decode-only rounds per prefill pass while a sibling fills (0: stock one-window cadence)
PLE_ON_SSD=1                                  # n-gram tables from SSD; that RAM goes to the KV cache (tested PLE_ON_SSD=0 at 512k: prefill 3% slower)
VISION=1                                      # 0: text only (with PLE_ON_SSD=1 the recipe still pins 2,048-row prefill chunks)
VISION_URLS=0                                 # 1: also accept public https:// image and video URLs
# VISION_MAX_IMAGES=50                        # images a request may carry (default 50); they share TENSORFOLD_IMAGE_TOKENS
MTP_DRAFTS=6
MTP_CONFIDENCE=0.60                           # 6/0.60 was the best sweep result (prose and code)
TEMPERATURE=1.0
TOP_P=0.95
TOP_K=20
THINKING=1                                    # 0: no think block by default; a request can still enable it
# MAX_TOKENS=32768                            # reply length for a request without max_tokens (default since v0.6.1; TensorFold's own 4,096 could end a thinking reply before it answers)


# --- TensorFold switches (defaults shown; start.sh passes every TENSORFOLD_* into the container) ---
TENSORFOLD_PREFILL_ROWS=4096    # 512k prefill 332.6s vs ~342s at 2048 rows; 8192 tied 4096, so stay here
# TENSORFOLD_MEMORY_RESERVE_GIB=2 # GiB of MemAvailable kept out of TensorFold's budget; 2 still fits 5 x 262,144 int8
# TENSORFOLD_MTP_COPY=1           # prompt-lookup copy drafts ahead of MTP (+6% on replies that repeat the prompt); 0: off
# TENSORFOLD_IMAGE_TOKENS=16384   # token budget shared by a request's images (each image at most 4,096)
# TENSORFOLD_VIDEO_TOKENS=16384   # token budget for the whole video
# TENSORFOLD_VISION_WORKSPACE_MIB=0
# TENSORFOLD_NO_UPDATE_CHECK=1    # no "newer TensorFold" call to GitHub at each start
# --- caches (defaults live under $HOME, so leave unset) ---------------------------
# HF_CACHE=$HOME/.cache/huggingface
# KERNEL_CACHE=$HOME/.cache/tensorfold-qwen38

# --- disk checks (free GB prepare.sh demands before downloading/building) ---------
# MIN_FREE_GB=125
# IMAGE_FREE_GB=35

# --- start.sh / stop.sh / prepare.sh ----------------------------------------------
WAIT_TIMEOUT=1800                             # start.sh: max seconds to wait for the server to be ready
STOP_TIMEOUT=30                               # stop.sh: seconds to wait for a graceful stop
# PULL=1   # prepare.sh: 0 builds locally instead of pulling the prebuilt image
# PREPARE=auto                                # start.sh: 0 skips the prepare.sh check
# FOREGROUND=1   # start.sh: stay attached to the server log, exit with the server's code

# --- scripts/publish-image.sh (secret: keep in the environment, not here) ---------
# GHCR_TOKEN=                                 # or GITHUB_TOKEN; a gh session is used if neither
# GHCR_USER=
# REPO_URL=https://github.com/MiaAI-Lab/Qwen3.8-Flash-Next-Single-DGX-Spark-TensorFold

# --- TensorFold switches ---
TENSORFOLD_MTP_COPY=1  # prompt-lookup copy drafts ahead of MTP (documented +6% on prompt-repeating replies)
